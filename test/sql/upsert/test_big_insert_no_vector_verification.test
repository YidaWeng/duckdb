# name: test/sql/upsert/test_big_insert_no_vector_verification.test
# description: Test ON CONFLICT statement on the same conflicting row.
# group: [upsert]

require vector_size 2048

statement ok
SET preserve_insertion_order = false;

statement ok
CREATE TABLE integers(
	i INT UNIQUE,
	j INT DEFAULT 0,
	k INT DEFAULT 0
);

statement ok
INSERT INTO integers(i) SELECT i FROM range(5000) tbl(i);

# Every key is proposed many times in this insert. Rejecting the duplicates is the only way to avoid applying just
# one of the rows for each key.
statement error
INSERT INTO integers(i, j)
SELECT i % 5, i
FROM range(5000) tbl(i) ON CONFLICT DO UPDATE SET
	j = excluded.j,
	k = excluded.i;
----
ON CONFLICT DO UPDATE can not update the same row twice in the same command

# A large insert without duplicate keys still goes through
statement ok
INSERT INTO integers(i, j)
SELECT i, i
FROM range(5000, 10000) tbl(i) ON CONFLICT DO UPDATE SET
	j = excluded.j,
	k = excluded.i;

query II
SELECT count(*), min(i) FROM integers
----
10000	0
