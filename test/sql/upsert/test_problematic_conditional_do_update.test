# name: test/sql/upsert/test_problematic_conditional_do_update.test
# description: Conditional upserts reject duplicate input keys instead of picking one of them
# group: [upsert]

foreach threads 1 4

statement ok
SET threads = {threads}

statement ok
CREATE TABLE users (
	id BIGINT PRIMARY KEY,
	username TEXT UNIQUE,
	email TEXT
);

# Duplicate conflict candidates are rejected before the UPDATE condition is evaluated - neither row is applied
statement error
INSERT INTO users (id, username, email)
VALUES
	(3, 'inner_conflict', 'test'),
	(3, 'inner_conflict2', 'other_test'),
	(3, 'inner_conflict3', 'filtered_out')
ON CONFLICT (id) DO
    UPDATE SET email = EXCLUDED.email
    WHERE EXCLUDED.email != 'filtered_out'
RETURNING id;
----
ON CONFLICT DO UPDATE can not update the same row twice in the same command

query I
SELECT count(*) FROM users
----
0

statement ok
INSERT INTO users VALUES (3, 'existing_user', 'other_test')

# The condition sees the existing target value, not the value proposed for insertion - the update is skipped
query IT
INSERT INTO users VALUES (3, 'inner_conflict', 'yet_another_test')
ON CONFLICT (id) DO UPDATE SET email = EXCLUDED.email
WHERE email != 'other_test' OR EXCLUDED.email = 'dont_skip_me'
RETURNING id, username;
----

query ITT
SELECT * FROM users
----
3	existing_user	other_test

# An EXCLUDED value can still make the same condition true
query ITT
INSERT INTO users VALUES (3, 'inner_conflict', 'dont_skip_me')
ON CONFLICT (id) DO UPDATE SET email = EXCLUDED.email
WHERE email != 'other_test' OR EXCLUDED.email = 'dont_skip_me'
RETURNING *;
----
3	existing_user	dont_skip_me

query ITT
SELECT * FROM users
----
3	existing_user	dont_skip_me

# Equal duplicate payloads are rejected too - only the count of rows per key matters
statement error
INSERT INTO users VALUES
    (3, 'unused_username', 'yet_another_test'),
    (3, 'unused_username', 'yet_another_test')
ON CONFLICT (id) DO UPDATE SET email = EXCLUDED.email
WHERE email != 'other_test' OR EXCLUDED.email = 'dont_skip_me'
RETURNING *;
----
ON CONFLICT DO UPDATE can not update the same row twice in the same command

query ITT
SELECT * FROM users
----
3	existing_user	dont_skip_me

statement ok
DROP TABLE users

endloop
